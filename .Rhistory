x %in% c("yes","y","true","t")
}
yn_false <- function(x) {
x <- clean_text(x)
x %in% c("no","n","false","f")
}
count_pct <- function(v) {
tibble(value = v) |>
mutate(value = clean_text(value),
value = dplyr::if_else(is.na(value) | value == "", "missing", value)) |>
mutate(value = forcats::fct_infreq(factor(value))) |>
count(value, name = "n") |>
mutate(pct = round(100 * n / sum(n), 1))
}
